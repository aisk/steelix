; Loaded as one `(begin ...)` by `vm.load`: definitions over several lines.
(define (make-counter)
  (let ((n 0))
    (lambda () (set! n (+ n 1)) n)))
(define c (make-counter))
(c)
(c)
(define-syntax unless
  (syntax-rules ()
    ((_ test body ...) (if test #f (begin body ...)))))
(define (filter-lt p lst)
  (cond ((null? lst) '())
        ((< (car lst) p) (cons (car lst) (filter-lt p (cdr lst))))
        (else (filter-lt p (cdr lst)))))
(define (filter-ge p lst)
  (cond ((null? lst) '())
        ((>= (car lst) p) (cons (car lst) (filter-ge p (cdr lst))))
        (else (filter-ge p (cdr lst)))))
(define (qsort lst)
  (if (null? lst)
      '()
      (append (qsort (filter-lt (car lst) (cdr lst)))
              (list (car lst))
              (qsort (filter-ge (car lst) (cdr lst))))))
(unless (> 1 2) (display (qsort '(3 1 4 1 5 9 2 6 5 3 5))) (newline))
(list (c) (qsort (list 2 1)) (string-append "s" "t"))
