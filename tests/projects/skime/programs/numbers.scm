(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(fact 10)
(fact 30)
(map fact '(0 1 2 3 4 5))
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(fib 20)
(define (fib-iter n) (let loop ((a 0) (b 1) (i 0)) (if (= i n) a (loop b (+ a b) (+ i 1)))))
(fib-iter 100)
(define (count-down n) (if (= n 0) 'done (count-down (- n 1))))
(count-down 100000)
(define (sum-to n acc) (if (= n 0) acc (sum-to (- n 1) (+ acc n))))
(sum-to 50000 0)
(define (even2? n) (if (= n 0) #t (odd2? (- n 1))))
(define (odd2? n) (if (= n 0) #f (even2? (- n 1))))
(even2? 10001)
(do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 5) acc))
